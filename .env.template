# Nordvet case: environment template
#
# This file is committed and holds placeholders only. Never put real values here.
#
# The real file lives OUTSIDE the repo, at:
#   ~/.config/nordvet/.env
# The code reads it from the path in NORDVET_ENV_FILE (default: that path).
# Docker Compose is started with: docker compose --env-file ~/.config/nordvet/.env up -d
#
# Copy the variable names below into the real file and fill in the values yourself.

# --- VetOne API ---
# Base URL is not secret (it is in the case brief).
VETONE_API_BASE_URL=https://vetone-api.kinddesert-e2c4fbdc.westeurope.azurecontainerapps.io
# Credentials come from the case PDF. Fill in locally only.
VETONE_CLIENT_ID=
VETONE_CLIENT_SECRET=

# --- Local SQL Server 2022 (Docker) ---
# SQL Server rejects weak passwords: at least 8 characters, with 3 of 4 of
# uppercase, lowercase, digits and symbols. Pick something local-only and not reused anywhere.
MSSQL_SA_PASSWORD=
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=nordvet
